# OpenRouter management-API key, used only by provider-usage's "every key on the account"
# table (GET https://openrouter.ai/api/v1/keys). Optional — without it the Hermes-runtime-key
# card still works, the account-wide keys table just reports "not configured".
#
# provider-usage reads this file fresh on every request; it is never cached on the module/
# process and never sent to the browser. Falls back to the OPENROUTER_MANAGEMENT_API_KEY
# process env var if this file is absent.
#
# Default path plugin_api.py reads: ~/dev/services/_scripts/openrouter-spend/.env
# Copy this file there (without the .example suffix) and fill in your key, or export the
# env var directly.

OPENROUTER_MANAGEMENT_API_KEY=sk-or-...
